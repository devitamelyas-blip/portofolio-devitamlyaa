
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --cream: #F0EBE0;
    --off-white: #FAF8F4;
    --ink: #0E0C09;
    --ink-mid: #2A2520;
    --accent: #C8A96E;
    --accent-dark: #A0844A;
    --muted: #7A7268;
    --rule: rgba(200,169,110,0.25);
  }

  html { scroll-behavior: smooth; }

  body {
    background: var(--ink);
    color: var(--cream);
    font-family: 'Sora', sans-serif;
    font-weight: 300;
    overflow-x: hidden;
    cursor: none;
  }

  .cursor {
    position: fixed;
    top: 0; left: 0;
    width: 10px; height: 10px;
    background: var(--accent);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9999;
    transition: transform 0.15s ease;
    transform: translate(-50%, -50%);
  }
  .cursor-ring {
    position: fixed;
    top: 0; left: 0;
    width: 40px; height: 40px;
    border: 1px solid rgba(200,169,110,0.5);
    border-radius: 50%;
    pointer-events: none;
    z-index: 9998;
    transform: translate(-50%, -50%);
    transition: all 0.3s ease;
  }
  body:hover .cursor-ring { opacity: 1; }

  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    padding: 1.5rem 4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    mix-blend-mode: normal;
  }
  nav::after {
    content: '';
    position: absolute;
    bottom: 0; left: 4rem; right: 4rem;
    height: 1px;
    background: var(--rule);
  }
  .nav-logo {
    font-family: 'Playfair Display', serif;
    font-size: 1.1rem;
    letter-spacing: 0.05em;
    color: var(--cream);
    text-decoration: none;
  }
  .nav-links {
    display: flex;
    gap: 2.5rem;
    list-style: none;
  }
  .nav-links a {
    font-family: 'DM Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.3s;
  }
  .nav-links a:hover { color: var(--accent); }

  #hero {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 1fr 1fr;
    position: relative;
    overflow: hidden;
  }

  .hero-img-col {
    position: relative;
    overflow: hidden;
  }
  .hero-img-col img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    filter: sepia(20%) contrast(1.05);
    transform: scale(1.05);
    animation: imgReveal 1.8s cubic-bezier(0.77,0,0.175,1) forwards;
  }
  @keyframes imgReveal {
    from { transform: scale(1.15); clip-path: inset(0 100% 0 0); }
    to   { transform: scale(1.05); clip-path: inset(0 0% 0 0); }
  }

  .hero-img-label {
    position: absolute;
    bottom: 3rem;
    left: 1.5rem;
    writing-mode: vertical-lr;
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(240,235,224,0.5);
  }

  .hero-img-col::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, transparent 70%, var(--ink));
  }

  .hero-text-col {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 0 5rem 5rem 5rem;
    position: relative;
  }

  .hero-index {
    position: absolute;
    top: 7rem;
    right: 5rem;
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    color: var(--muted);
  }

  .hero-eyebrow {
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: up 0.8s 0.3s forwards;
  }

  h1.hero-name {
    font-family: 'Playfair Display', serif;
    font-size: clamp(3rem, 6vw, 5.5rem);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -0.02em;
    color: var(--off-white);
    margin-bottom: 0.3rem;
    opacity: 0;
    animation: up 0.9s 0.5s forwards;
  }
  h1.hero-name em {
    font-style: italic;
    color: var(--accent);
  }

  .hero-title-line {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin: 1.8rem 0 2.5rem;
    opacity: 0;
    animation: up 0.8s 0.7s forwards;
  }
  .hero-title-line::before {
    content: '';
    display: block;
    width: 3rem;
    height: 1px;
    background: var(--accent);
  }
  .hero-title-text {
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    text-transform: uppercase;
  }

  .hero-desc {
    font-size: 1rem;
    line-height: 1.8;
    color: rgba(240,235,224,0.6);
    max-width: 28rem;
    margin-bottom: 3rem;
    opacity: 0;
    animation: up 0.8s 0.9s forwards;
  }

  .hero-cta-group {
    display: flex;
    gap: 1.2rem;
    align-items: center;
    opacity: 0;
    animation: up 0.8s 1.1s forwards;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 2rem;
    background: var(--accent);
    color: var(--ink);
    font-family: 'DM Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
  }
  .btn-primary::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0;
    width: 100%; height: 100%;
    background: var(--ink);
    transform: translateY(101%);
    transition: transform 0.4s cubic-bezier(0.77,0,0.175,1);
  }
  .btn-primary:hover { color: var(--accent); }
  .btn-primary:hover::after { transform: translateY(0); }
  .btn-primary span { position: relative; z-index: 1; }

  .btn-ghost {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 2rem;
    border: 1px solid rgba(200,169,110,0.4);
    color: var(--muted);
    font-family: 'DM Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s ease;
  }
  .btn-ghost:hover { border-color: var(--accent); color: var(--accent); }

  .scroll-hint {
    position: absolute;
    bottom: 3rem;
    right: 5rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    opacity: 0;
    animation: up 0.8s 1.5s forwards;
  }
  .scroll-hint span {
    writing-mode: vertical-lr;
    font-family: 'DM Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .scroll-line {
    width: 1px;
    height: 4rem;
    background: var(--rule);
    position: relative;
    overflow: hidden;
  }
  .scroll-line::after {
    content: '';
    position: absolute;
    top: -100%;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--accent);
    animation: scrollAnim 1.8s ease-in-out 2s infinite;
  }
  @keyframes scrollAnim {
    from { top: -100%; }
    to   { top: 100%; }
  }

  @keyframes up {
    from { opacity: 0; transform: translateY(24px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .marquee-strip {
    background: var(--accent);
    padding: 0.85rem 0;
    overflow: hidden;
    display: flex;
  }
  .marquee-track {
    display: flex;
    gap: 0;
    animation: marquee 18s linear infinite;
    white-space: nowrap;
  }
  .marquee-track span {
    display: inline-flex;
    align-items: center;
    gap: 1.5rem;
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink);
    padding: 0 2rem;
  }
  .marquee-track .dot {
    width: 4px; height: 4px;
    border-radius: 50%;
    background: var(--ink-mid);
    display: inline-block;
    opacity: 0.5;
  }
  @keyframes marquee {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  #skills {
    padding: 7rem 4rem;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 4rem;
    border-bottom: 1px solid var(--rule);
  }
  .section-label {
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }
  .section-label::before {
    content: attr(data-num);
    color: var(--muted);
    font-size: 0.6rem;
  }
  .skills-header h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 400;
    line-height: 1.15;
    color: var(--cream);
    margin-top: 1.5rem;
  }
  .skills-header h2 em {
    font-style: italic;
    color: var(--accent);
  }
  .skills-header p {
    margin-top: 1.5rem;
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--muted);
    max-width: 22rem;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1px;
    background: var(--rule);
  }
  .skill-card {
    background: var(--ink);
    padding: 2rem 2rem 2rem;
    position: relative;
    transition: background 0.3s ease;
  }
  .skill-card:hover { background: var(--ink-mid); }
  .skill-tag {
    font-family: 'DM Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 1rem;
    opacity: 0.7;
  }
  .skill-card h3 {
    font-family: 'Sora', sans-serif;
    font-size: 1rem;
    font-weight: 500;
    color: var(--cream);
    margin-bottom: 0.75rem;
  }
  .skill-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .skill-pill {
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.05em;
    color: var(--muted);
    border: 1px solid rgba(122,114,104,0.3);
    padding: 0.3rem 0.75rem;
    transition: all 0.2s;
  }
  .skill-pill:hover { border-color: var(--accent); color: var(--accent); }

  #projects {
    padding: 7rem 4rem;
    border-bottom: 1px solid var(--rule);
  }
  .projects-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 4rem;
  }
  .projects-head h2 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2rem, 4vw, 3.2rem);
    font-weight: 400;
    color: var(--cream);
    line-height: 1.1;
  }
  .projects-head h2 em { font-style: italic; color: var(--accent); }

  .project-list { display: flex; flex-direction: column; }
  .project-item {
    display: grid;
    grid-template-columns: 3.5rem 1.1fr 1.3fr 11rem;
    align-items: center;
    padding: 2rem 0;
    border-top: 1px solid var(--rule);
    text-decoration: none;
    transition: all 0.3s;
    position: relative;
    gap: 2rem;
  }
  .project-item:last-child { border-bottom: 1px solid var(--rule); }
  .project-item:hover { padding-left: 1rem; }
  .project-item:hover .project-num { color: var(--accent); }
  .project-num {
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    color: var(--muted);
    transition: color 0.3s;
  }
  .project-name {
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--cream);
    transition: color 0.3s;
  }
  .project-item:hover .project-name { color: var(--accent); }
  .project-desc {
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    justify-content: flex-end;
  }
  .ptag {
    font-family: 'DM Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    color: var(--muted);
    border: 1px solid var(--rule);
    padding: 0.25rem 0.6rem;
  }

  #experience {
    padding: 7rem 4rem;
    border-bottom: 1px solid var(--rule);
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: 6rem;
  }
  .experience-list { display: flex; flex-direction: column; gap: 0; }
  .exp-item {
    padding: 2rem 0;
    border-top: 1px solid var(--rule);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    position: relative;
  }
  .exp-item:last-child { border-bottom: 1px solid var(--rule); }
  .exp-period {
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--muted);
    text-transform: uppercase;
    margin-bottom: 0.75rem;
  }
  .exp-role {
    font-family: 'Playfair Display', serif;
    font-size: 1.15rem;
    font-weight: 400;
    color: var(--cream);
    margin-bottom: 0.4rem;
  }
  .exp-company {
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    color: var(--accent);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .exp-details {
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.75;
  }
  .exp-badge {
    display: inline-block;
    font-family: 'DM Mono', monospace;
    font-size: 0.6rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border: 1px solid rgba(200,169,110,0.3);
    color: var(--accent);
    padding: 0.2rem 0.6rem;
    margin-bottom: 1rem;
  }

  #contact {
    padding: 8rem 4rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6rem;
    align-items: center;
  }
  .contact-big {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 400;
    line-height: 1.1;
    color: var(--cream);
  }
  .contact-big em { font-style: italic; color: var(--accent); }
  .contact-sub {
    margin-top: 1.5rem;
    font-size: 0.9rem;
    line-height: 1.8;
    color: var(--muted);
  }
  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
  .contact-link-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.5rem 0;
    border-top: 1px solid var(--rule);
    text-decoration: none;
    color: var(--cream);
    transition: all 0.3s;
  }
  .contact-link-item:last-child { border-bottom: 1px solid var(--rule); }
  .contact-link-item:hover { padding-left: 0.75rem; }
  .cli-label {
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    display: block;
    margin-bottom: 0.3rem;
  }
  .cli-value {
    font-family: 'Sora', sans-serif;
    font-size: 0.95rem;
    color: var(--cream);
    transition: color 0.3s;
  }
  .contact-link-item:hover .cli-value { color: var(--accent); }
  .cli-arrow {
    font-size: 1.2rem;
    color: var(--muted);
    transition: transform 0.3s, color 0.3s;
  }
  .contact-link-item:hover .cli-arrow { transform: translateX(4px) translateY(-4px); color: var(--accent); }

  footer {
    padding: 2rem 4rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top: 1px solid var(--rule);
  }
  .footer-copy {
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .footer-back {
    font-family: 'DM Mono', monospace;
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    transition: color 0.3s;
  }
  .footer-back:hover { color: var(--accent); }

  .reveal {
    opacity: 0;
    transform: translateY(28px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  .reveal.visible { opacity: 1; transform: translateY(0); }
  .reveal-delay-1 { transition-delay: 0.1s; }
  .reveal-delay-2 { transition-delay: 0.22s; }
  .reveal-delay-3 { transition-delay: 0.34s; }

  @media (max-width: 768px) {
    nav { padding: 1.2rem 1.5rem; }
    nav::after { left: 1.5rem; right: 1.5rem; }
    .nav-links { display: none; }
    #hero { grid-template-columns: 1fr; }
    .hero-img-col { height: 55vw; }
    .hero-text-col { padding: 2.5rem 1.5rem; }
    #skills { grid-template-columns: 1fr; padding: 4rem 1.5rem; }
    .skills-grid { grid-template-columns: 1fr; }
    #projects { padding: 4rem 1.5rem; }
    .project-item { grid-template-columns: 3rem 1fr; }
    .project-desc, .project-tags { display: none; }
    #experience { grid-template-columns: 1fr; padding: 4rem 1.5rem; gap: 2rem; }
    .exp-item { grid-template-columns: 1fr; }
    #contact { grid-template-columns: 1fr; padding: 4rem 1.5rem; gap: 2rem; }
    footer { padding: 1.5rem; flex-direction: column; gap: 1rem; }
    .scroll-hint { display: none; }
  }
